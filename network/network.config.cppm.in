module;

#include <cstdint>
#include <string>

#include "silicon/network/common.h"

export module silicon.network:config;


namespace silicon::network {
export inline NET_API const std::string GetVersion() { return "${VERSION}"; }
export inline NET_API std::uint32_t GetVersionMajor() { return ${VERSION_MAJOR}; }
export inline NET_API std::uint32_t GetVersionMinor() { return ${VERSION_MINOR}; }
export inline NET_API std::uint32_t GetVersionAlter() { return ${VERSION_ALTER}; }
export inline NET_API std::uint64_t GetVersionBuild() { return ${VERSION_BUILD}; }
export inline NET_API const std::string GetVersionBranch() { return "${GIT_BRANCH}"; }
export inline NET_API const std::string GetVersionCommit() { return "${GIT_COMMIT}"; }
} // namespace silicon::network
