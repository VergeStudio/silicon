module;

#include <cstdint>
#include <string>

#include "silicon/cli/common.h"

export module silicon.cli:config;

namespace silicon::cli {
export CLI_API const std::string GetVersion() { return "${VERSION}"; }
export CLI_API std::uint32_t GetVersionMajor() { return ${VERSION_MAJOR}; }
export CLI_API std::uint32_t GetVersionMinor() { return ${VERSION_MINOR}; }
export CLI_API std::uint32_t GetVersionAlter() { return ${VERSION_ALTER}; }
export CLI_API std::uint64_t GetVersionBuild() { return ${VERSION_BUILD}; }
export CLI_API const std::string GetVersionBranch() { return "${GIT_BRANCH}"; }
export CLI_API const std::string GetVersionCommit() { return "${GIT_COMMIT}"; }
} // namespace silicon::cli
