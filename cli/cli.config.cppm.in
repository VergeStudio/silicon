module;

#include <cstdint>
#include <string>

export module silicon.cli:config;

#include "silicon/cli/common.h"

namespace silicon::cli {
export inline CLI_API const std::string GetVersion() { return "${VERSION}"; }
export inline CLI_API std::uint32_t GetVersionMajor() { return ${VERSION_MAJOR}; }
export inline CLI_API std::uint32_t GetVersionMinor() { return ${VERSION_MINOR}; }
export inline CLI_API std::uint32_t GetVersionAlter() { return ${VERSION_ALTER}; }
export inline CLI_API std::uint64_t GetVersionBuild() { return ${VERSION_BUILD}; }
export inline CLI_API const std::string GetVersionBranch() { return "${GIT_BRANCH}"; }
export inline CLI_API const std::string GetVersionCommit() { return "${GIT_COMMIT}"; }
} // namespace silicon::cli

