module;

#include <cstdint>
#include <string>

#include "silicon/scheduler/common.h"

export module silicon.scheduler:config;

// 与 coroutine/di/core 的 config 分区保持一致：import std 使标准库在本模块所有
// 实现单元（含 io_notifier_* / timer_handle 后端）的模块 purview 内可见，
// 后端 .cpp 不必逐一显式 include <mutex>/<vector>/<array>/<tuple>/<atomic> 等。
import std;


namespace silicon::scheduler {
export inline SCHEDULER_API const std::string GetVersion() { return "${VERSION}"; }
export inline SCHEDULER_API std::uint32_t GetVersionMajor() { return ${VERSION_MAJOR}; }
export inline SCHEDULER_API std::uint32_t GetVersionMinor() { return ${VERSION_MINOR}; }
export inline SCHEDULER_API std::uint32_t GetVersionAlter() { return ${VERSION_ALTER}; }
export inline SCHEDULER_API std::uint64_t GetVersionBuild() { return ${VERSION_BUILD}; }
export inline SCHEDULER_API const std::string GetVersionBranch() { return "${GIT_BRANCH}"; }
export inline SCHEDULER_API const std::string GetVersionCommit() { return "${GIT_COMMIT}"; }
} // namespace silicon::scheduler
