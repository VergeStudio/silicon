module;

#include <cstdint>
#include <string>

#include "silicon/proxy/common.h"

export module silicon.proxy:config;

namespace silicon::proxy {
export PROXY_API const std::string GetVersion() { return "${VERSION}"; }
export PROXY_API std::uint32_t GetVersionMajor() { return ${VERSION_MAJOR}; }
export PROXY_API std::uint32_t GetVersionMinor() { return ${VERSION_MINOR}; }
export PROXY_API std::uint32_t GetVersionAlter() { return ${VERSION_ALTER}; }
export PROXY_API std::uint64_t GetVersionBuild() { return ${VERSION_BUILD}; }
export PROXY_API const std::string GetVersionBranch() { return "${GIT_BRANCH}"; }
export PROXY_API const std::string GetVersionCommit() { return "${GIT_COMMIT}"; }
} // namespace silicon::proxy

