module;

#include <cstdint>
#include <string>

export module silicon.di:config;

import std;

namespace silicon::di {
export const std::string GetVersion() { return "${VERSION}"; }
export std::uint32_t GetVersionMajor() { return ${VERSION_MAJOR}; }
export std::uint32_t GetVersionMinor() { return ${VERSION_MINOR}; }
export std::uint32_t GetVersionAlter() { return ${VERSION_ALTER}; }
export std::uint64_t GetVersionBuild() { return ${VERSION_BUILD}; }
export const std::string GetVersionBranch() { return "${GIT_BRANCH}"; }
export const std::string GetVersionCommit() { return "${GIT_COMMIT}"; }
} // namespace silicon::di
