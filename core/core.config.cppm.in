module;

#include <cstdint>

#include "silicon/common.h"

export module silicon.core:config;

import std;

namespace silicon::core {
export inline SILICON_CORE_API const std::string get_version() { return "${VERSION}"; }
export inline SILICON_CORE_API std::uint32_t get_version_major() { return ${VERSION_MAJOR}; }
export inline SILICON_CORE_API std::uint32_t get_version_minor() { return ${VERSION_MINOR}; }
export inline SILICON_CORE_API std::uint32_t get_version_alter() { return ${VERSION_ALTER}; }
export inline SILICON_CORE_API std::uint64_t get_version_build() { return ${VERSION_BUILD}; }
export inline SILICON_CORE_API const std::string get_version_branch() { return "${GIT_BRANCH}"; }
export inline SILICON_CORE_API const std::string get_version_commit() { return "${GIT_COMMIT}"; }
} // namespace silicon::core

